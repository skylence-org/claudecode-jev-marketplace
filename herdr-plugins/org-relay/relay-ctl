#!/bin/sh
# relay-ctl: start/stop/status/run/install-daemon/rollback/send/purge for the org-relay
# MCP server. install-daemon is the production path: it refuses a dirty tree,
# copies the release binary to a VERSIONED slot outside the repo, repoints the
# `current` symlink, restarts launchd, and verifies the served sha matches the
# installed one. The plist execs the symlink, so repo churn (cargo clean,
# branch switches, moves) can never touch a running daemon, and rollback is a
# symlink repoint away. Legacy repo-path deployment is gone on purpose.
set -u
# Resolve through symlinks: install-daemon links this script into
# ~/.local/bin, and DIR must still name the crate (target/, nudge-deliver).
SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
DIR=$(cd "$(dirname "$SELF")" && pwd)
# Where install-daemon links the CLI, so a job can end with a bare
# `relay-ctl send ...` (RELAY_CTL_BIN_DIR overrides, for tests).
CLI_DIR="${RELAY_CTL_BIN_DIR:-$HOME/.local/bin}"
PORT="${ORG_RELAY_PORT:-7431}"
BIN="$DIR/target/release/org-relay"
PIDFILE="${TMPDIR:-/tmp}/org-relay.$PORT.pid"
LABEL=com.skylence.org-relay
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
# Installed binaries live OUTSIDE the repo; `current` is what launchd runs.
LIBEXEC="$HOME/.local/libexec/org-relay"
CURRENT="$LIBEXEC/current"
KEEP_BINARIES=3
# ONE server serves the whole box, so the db is box-wide by default — this is
# what makes cross-org (peer orchestrator) messages deliverable. Override with
# ORG_RELAY_DB only when you genuinely want an isolated bus.
BOX_DB="$HOME/.config/herdr/org-relay/relay.db"

alive() { curl -s -m 2 "http://127.0.0.1:$PORT/health" 2>/dev/null | grep -q ok; }
served_sha() { curl -s -m 3 "http://127.0.0.1:$PORT/health" 2>/dev/null | jq -r '.build.sha // empty' 2>/dev/null; }
ensure_bin() {
  if [ ! -x "$BIN" ]; then
    echo "org-relay: no release binary; building..." >&2
    (cd "$DIR" && cargo build --release >/dev/null 2>&1) || { echo "org-relay: build failed" >&2; exit 1; }
  fi
}
runnable() {
  # The installed daemon binary when present, else the repo build (ad-hoc dev).
  if [ -x "$CURRENT" ]; then echo "$CURRENT"; else ensure_bin; echo "$BIN"; fi
}
write_plist_and_bootstrap() {
  mkdir -p "$(dirname "$BOX_DB")" "$HOME/Library/LaunchAgents"
  # The nudge watchdog shells out to herdr (via nudge-deliver), and launchd's
  # default PATH does not contain the herdr install dir: bake the resolving
  # PATH and an explicit HERDR_BIN_PATH into the plist at install time. The
  # helper path is pinned too, since the daemon no longer lives beside it.
  HERDR_RESOLVED=$(command -v "${HERDR_BIN_PATH:-herdr}" 2>/dev/null || echo herdr)
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$CURRENT</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>ORG_RELAY_PORT</key><string>$PORT</string>
    <key>ORG_RELAY_DB</key><string>$BOX_DB</string>
    <key>ORG_RELAY_NUDGE_HELPER</key><string>$DIR/nudge-deliver</string>
    <key>PATH</key><string>$PATH</string>
    <key>HERDR_BIN_PATH</key><string>$HERDR_RESOLVED</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${TMPDIR:-/tmp}/org-relay.$PORT.log</string>
  <key>StandardErrorPath</key><string>${TMPDIR:-/tmp}/org-relay.$PORT.log</string>
</dict></plist>
EOF
  # Hand the port over: stop any ad-hoc instance, then bootstrap. A bootout
  # can still be settling when the bootstrap lands (observed: "Load failed:
  # 5: Input/output error" with a clean plist), so retry once after a pause.
  "$0" stop >/dev/null 2>&1 || true
  launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
    || { sleep 10; launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null; } \
    || launchctl load "$PLIST"
  sleep 2
}
verify_serving() {
  want=$1
  got=$(served_sha)
  if [ -z "$got" ]; then
    echo "org-relay: VERIFY FAILED — daemon not serving; see ${TMPDIR:-/tmp}/org-relay.$PORT.log" >&2
    return 1
  fi
  if [ "$got" != "$want" ]; then
    echo "org-relay: VERIFY FAILED — serving sha $got, expected $want" >&2
    return 1
  fi
  echo "org-relay: serving verified sha $got on :$PORT"
}
link_cli() {
  mkdir -p "$CLI_DIR" 2>/dev/null || { echo "org-relay: cannot create $CLI_DIR; call $DIR/relay-ctl by its absolute path" >&2; return 1; }
  ln -sfn "$DIR/relay-ctl" "$CLI_DIR/relay-ctl" || { echo "org-relay: cannot link $CLI_DIR/relay-ctl" >&2; return 1; }
  echo "org-relay: relay-ctl linked at $CLI_DIR/relay-ctl -> $DIR/relay-ctl"
  case ":$PATH:" in
    *":$CLI_DIR:"*) ;;
    *) echo "org-relay: $CLI_DIR is not on PATH: add it, or call $DIR/relay-ctl by its absolute path" ;;
  esac
}

case "${1:-status}" in
  run)
    # Foreground exec for launchd-free ad-hoc use.
    B=$(runnable)
    mkdir -p "$(dirname "${ORG_RELAY_DB:-$BOX_DB}")"
    ORG_RELAY_NUDGE_HELPER="${ORG_RELAY_NUDGE_HELPER:-$DIR/nudge-deliver}" ORG_RELAY_DB="${ORG_RELAY_DB:-$BOX_DB}" exec "$B"
    ;;
  install-daemon)
    ensure_bin
    # Production gate: never install from a dirty crate tree. The binary bakes
    # its dirty flag at build time, so trust the BINARY's own attestation
    # (a clean tree with a stale dirty build would lie the other way).
    ver_line=$("$BIN" --version 2>/dev/null) || { echo "org-relay: binary has no --version; rebuild" >&2; exit 1; }
    set -- $ver_line
    VERSION=${2:-unknown}; SHA=${3:-unknown}; DIRTYF=${4:-unknown}
    # Gate semantics: "dirty" is uncommitted DEV drift — refuse. "unknown"
    # splits by context: inside a git checkout it means broken attestation
    # (refuse), but a consumer box's `herdr plugin install` snapshot has no
    # .git at all, provenance is structurally unknowable, and the drift the
    # gate exists to stop cannot occur — allow with a warning.
    if [ "$DIRTYF" = "dirty" ] && [ "${ORG_RELAY_ALLOW_DIRTY:-}" != "1" ]; then
      echo "org-relay: REFUSING install: binary built from a dirty tree ($ver_line)." >&2
      echo "  Commit first and rebuild, or force with ORG_RELAY_ALLOW_DIRTY=1." >&2
      exit 1
    fi
    if [ "$DIRTYF" = "unknown" ] && [ "${ORG_RELAY_ALLOW_DIRTY:-}" != "1" ]; then
      if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
        echo "org-relay: REFUSING install: this is a git checkout but the binary attests unknown provenance ($ver_line) — rebuild so build.rs can see git." >&2
        exit 1
      fi
      echo "org-relay: non-repo install (consumer box): provenance unknown by design, proceeding." >&2
    fi
    mkdir -p "$LIBEXEC"
    SLOT="$LIBEXEC/org-relay-$VERSION+$SHA"
    cp "$BIN" "$SLOT.tmp" && mv "$SLOT.tmp" "$SLOT" && chmod +x "$SLOT"
    PREV=$(readlink "$CURRENT" 2>/dev/null || true)
    ln -sfn "$SLOT" "$CURRENT"
    write_plist_and_bootstrap
    if verify_serving "$SHA"; then
      [ -n "$PREV" ] && [ "$PREV" != "$SLOT" ] && echo "org-relay: rollback available: relay-ctl rollback (prev: $(basename "$PREV"))"
      # Retention: keep the newest KEEP_BINARIES slots plus whatever current
      # points at; older ones go.
      ls -t "$LIBEXEC"/org-relay-* 2>/dev/null | tail -n +$((KEEP_BINARIES + 1)) | while read -r old; do
        [ "$old" = "$(readlink "$CURRENT")" ] && continue
        rm -f "$old"
      done
      echo "org-relay: installed $(basename "$SLOT"), db=$BOX_DB"
      link_cli || true
    else
      if [ -n "$PREV" ] && [ -x "$PREV" ]; then
        echo "org-relay: reverting current -> $(basename "$PREV")" >&2
        ln -sfn "$PREV" "$CURRENT"
        launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null || true
      fi
      exit 1
    fi
    ;;
  rollback)
    [ -L "$CURRENT" ] || { echo "org-relay: nothing installed" >&2; exit 1; }
    NOW=$(readlink "$CURRENT")
    PREV=$(ls -t "$LIBEXEC"/org-relay-* 2>/dev/null | grep -vF "$NOW" | head -1)
    [ -n "$PREV" ] || { echo "org-relay: no previous binary to roll back to" >&2; exit 1; }
    ln -sfn "$PREV" "$CURRENT"
    launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null || true
    sleep 2
    want=$("$PREV" --version | awk '{print $3}')
    verify_serving "$want" && echo "org-relay: rolled back to $(basename "$PREV")"
    ;;
  start)
    if alive; then echo "org-relay: already serving on :$PORT"; exit 0; fi
    # Prefer the daemon when installed; kick it rather than forking an orphan.
    if [ -f "$PLIST" ]; then
      launchctl kickstart "gui/$(id -u)/$LABEL" 2>/dev/null || launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
      sleep 2
      alive && { echo "org-relay: started via launchd on :$PORT"; exit 0; }
    fi
    B=$(runnable)
    mkdir -p "$(dirname "${ORG_RELAY_DB:-$BOX_DB}")"
    ORG_RELAY_NUDGE_HELPER="${ORG_RELAY_NUDGE_HELPER:-$DIR/nudge-deliver}" ORG_RELAY_DB="${ORG_RELAY_DB:-$BOX_DB}" nohup "$B" >>"${TMPDIR:-/tmp}/org-relay.$PORT.log" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    alive && echo "org-relay: started on :$PORT (pid $(cat "$PIDFILE"); ad-hoc — prefer install-daemon)" || { echo "org-relay: failed to start; see ${TMPDIR:-/tmp}/org-relay.$PORT.log" >&2; exit 1; }
    ;;
  stop)
    launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 && { echo "org-relay: daemon stopped ($LABEL)"; exit 0; }
    if [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null; then
      rm -f "$PIDFILE"; echo "org-relay: stopped"
    else
      PID=$(lsof -ti tcp:"$PORT" 2>/dev/null | head -1)
      [ -n "${PID:-}" ] && kill "$PID" && echo "org-relay: stopped (pid $PID)" || echo "org-relay: not running"
    fi
    ;;
  purge)
    # ORPHANED QUEUES (1.5.0), operator-only: a message for an agent nobody
    # will ever be again (a peer org's agent, a reaped lane) sits unconsumed
    # forever. relay_status shows the shape (old oldest_age_s, awaiting false,
    # agent_live false, no last_seen_s); this removes it by hand. LISTING is
    # the default (--dry-run says so explicitly); only --delete removes, and
    # it removes exactly the ids it listed. Never run automatically. Writes
    # the db directly (sqlite3, WAL-safe with a busy timeout) and appends a
    # purge event to the audit stream beside it.
    shift
    P_RCPT=""; P_AGE=""; P_DELETE=0; P_IDS=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dry-run) shift; continue ;;
        --delete) P_DELETE=1; shift; continue ;;
      esac
      [ "$#" -ge 2 ] || { echo "relay-ctl purge: $1 needs a value" >&2; exit 2; }
      case "$1" in
        --recipient) P_RCPT=$2 ;;
        --older-than) P_AGE=$2 ;;
        --ids) P_IDS=$2 ;;
        *) echo "relay-ctl purge: unknown argument $1" >&2; exit 2 ;;
      esac
      shift 2
    done
    usage_p="usage: relay-ctl purge --recipient <name> --older-than <N>s|m|h|d [--ids <id,id,...>] [--dry-run | --delete]"
    [ -n "$P_RCPT" ] || { echo "relay-ctl purge: --recipient is required; $usage_p" >&2; exit 2; }
    case "$P_IDS" in
      "") ;;
      *[!0-9,]*|,*|*,|*,,*) echo "relay-ctl purge: --ids must be comma-separated message ids; $usage_p" >&2; exit 2 ;;
    esac
    case "$P_AGE" in
      *[!0-9smhd]*|"") echo "relay-ctl purge: --older-than must be <N>s|m|h|d; $usage_p" >&2; exit 2 ;;
    esac
    n=${P_AGE%?}; unit=${P_AGE#"$n"}
    case "$n" in ""|*[!0-9]*) echo "relay-ctl purge: --older-than must be <N>s|m|h|d; $usage_p" >&2; exit 2 ;; esac
    case "$unit" in s) secs=$n ;; m) secs=$((n * 60)) ;; h) secs=$((n * 3600)) ;; d) secs=$((n * 86400)) ;; *) echo "relay-ctl purge: --older-than must be <N>s|m|h|d; $usage_p" >&2; exit 2 ;; esac
    [ "$secs" -gt 0 ] || { echo "relay-ctl purge: --older-than must be more than 0 (0 would select every unconsumed message); $usage_p" >&2; exit 2; }
    command -v sqlite3 >/dev/null 2>&1 || { echo "relay-ctl purge: sqlite3 required" >&2; exit 2; }
    # The audit line is part of a delete: no jq, no delete (checked before
    # anything is touched).
    if [ "$P_DELETE" -eq 1 ] && ! command -v jq >/dev/null 2>&1; then
      echo "relay-ctl purge: --delete needs jq to write its audit record; nothing deleted" >&2
      exit 2
    fi
    DB="${ORG_RELAY_DB:-$BOX_DB}"
    [ -f "$DB" ] || { echo "relay-ctl purge: no relay db at $DB" >&2; exit 1; }
    rq=$(printf '%s' "$P_RCPT" | sed "s/'/''/g")
    where="consumed_at IS NULL AND recipient = '$rq' AND ts < strftime('%Y-%m-%dT%H:%M:%SZ', 'now', '-$secs seconds')"
    # --ids narrows a delete to exactly the rows of a listing you reviewed.
    [ -n "$P_IDS" ] && where="$where AND id IN ($P_IDS)"
    sq() { sqlite3 -cmd '.timeout 5000' "$DB" "$@"; }
    ids=$(sq "SELECT group_concat(id) FROM messages WHERE $where;")
    if [ -z "$ids" ]; then
      echo "relay-ctl purge: no unconsumed message for '$P_RCPT' older than $P_AGE in $DB"
      exit 0
    fi
    sq -header -separator ' | ' "SELECT id, ts, sender, kind, substr(replace(body, char(10), ' '), 1, 80) AS body FROM messages WHERE id IN ($ids) ORDER BY id;"
    count=$(printf '%s' "$ids" | tr ',' '\n' | grep -c .)
    if [ "$P_DELETE" -ne 1 ]; then
      echo "relay-ctl purge: $count unconsumed message(s) for '$P_RCPT' older than $P_AGE listed; nothing deleted (re-run with --delete, optionally --ids $ids, to remove exactly these)"
      exit 0
    fi
    deleted=$(sq "DELETE FROM messages WHERE id IN ($ids) AND consumed_at IS NULL; SELECT changes();")
    jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg r "$P_RCPT" --arg age "$P_AGE" --arg ids "$ids" --argjson n "${deleted:-0}" \
      '{ts: $ts, event: "purge", recipient: $r, older_than: $age, deleted: $n, ids: ($ids | split(",") | map(tonumber)), by: "relay-ctl"}' \
      >> "$(dirname "$DB")/audit.jsonl" 2>/dev/null \
      || echo "relay-ctl purge: WARNING: could not append the purge record to $(dirname "$DB")/audit.jsonl" >&2
    echo "relay-ctl purge: deleted ${deleted:-0} unconsumed message(s) for '$P_RCPT' (ids $ids)"
    ;;
  send)
    # JOB WAKES (1.5.0): enqueue one message exactly as relay_send does, from a
    # shell, so a long local job (a gate run, a CI watch) can end with
    #   ...; relay-ctl send --to <orchestrator> --kind job --body "job <id> rc=$?"
    # and wake the orchestrator through its one armed relay_await (or the nudge
    # net) instead of the orchestrator spending short-timeout awaits as a timer.
    # Rides POST /send, the same op as the tool: same validation, durable
    # enqueue, audit event, in-process wake. /send carries no MCP session, so
    # the guide gate does not apply, exactly as for any stateless caller; the
    # loopback bind is the trust boundary.
    shift
    S_TO=""; S_KIND=""; S_BODY=""; S_SENDER="relay-ctl"; S_LANE=""
    while [ "$#" -gt 0 ]; do
      [ "$#" -ge 2 ] || { echo "relay-ctl send: $1 needs a value" >&2; exit 2; }
      case "$1" in
        --to) S_TO=$2 ;;
        --kind) S_KIND=$2 ;;
        --body) S_BODY=$2 ;;
        --sender) S_SENDER=$2 ;;
        --lane) S_LANE=$2 ;;
        *) echo "relay-ctl send: unknown argument $1" >&2; exit 2 ;;
      esac
      shift 2
    done
    for v in "to:$S_TO" "kind:$S_KIND" "body:$S_BODY" "sender:$S_SENDER"; do
      [ -n "$(printf '%s' "${v#*:}" | tr -d '[:space:]')" ] || { echo "relay-ctl send: --${v%%:*} is required (usage: relay-ctl send --to <agent> --kind <kind> --body <text> [--sender <name>] [--lane <slug>])" >&2; exit 2; }
    done
    command -v jq >/dev/null 2>&1 || { echo "relay-ctl send: jq required" >&2; exit 2; }
    payload=$(jq -nc --arg s "$S_SENDER" --arg t "$S_TO" --arg k "$S_KIND" --arg b "$S_BODY" --arg l "$S_LANE" \
      '{sender: $s, to: $t, kind: $k, body: $b} + (if $l == "" then {} else {lane: $l} end)')
    out=$(mktemp "${TMPDIR:-/tmp}/relay-ctl-send.XXXXXX")
    code=$(curl -s -m 10 -o "$out" -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
      --data-binary "$payload" "http://127.0.0.1:$PORT/send" 2>/dev/null)
    rc=$?
    reply=$(cat "$out" 2>/dev/null); rm -f "$out"
    if [ "$rc" -ne 0 ]; then
      echo "relay-ctl send: no org-relay answering on :$PORT (curl rc=$rc); nothing was queued" >&2
      exit 1
    fi
    case "$code" in
      200) printf '%s\n' "$reply" ;;
      404) echo "relay-ctl send: the daemon on :$PORT has no POST /send (a build older than this repo's); install org-relay from herdr-plugins/org-relay (README). Nothing was queued." >&2; exit 1 ;;
      *) echo "relay-ctl send: refused (HTTP $code): $reply" >&2; exit 1 ;;
    esac
    ;;
  status)
    if alive; then
      echo "org-relay: serving on :$PORT"
      if command -v relay-ctl >/dev/null 2>&1; then
        echo "org-relay: cli $DIR/relay-ctl (on PATH as relay-ctl)"
      else
        echo "org-relay: cli $DIR/relay-ctl (not on PATH: call it by this path, or run install-daemon to link it into $CLI_DIR)"
      fi
      # rmcp streamable HTTP needs an MCP handshake per session, so the CLI
      # reads the plain GET /status mirror (never guide-gated); it carries the
      # daemon's own build attestation, summarized first so a drifted install
      # (same version, other repo or sha) is visible at a glance.
      st=$(curl -s -m 5 "http://127.0.0.1:$PORT/status" 2>/dev/null)
      if command -v jq >/dev/null 2>&1; then
        printf '%s' "$st" | jq -r '.build // {} | "org-relay: build \(.version // "?") sha \(.sha // "?")\(if .dirty then "-dirty" else "" end) built \(.built_at // "?") from \(.remote // "unknown remote (pre-1.5.0 build)") \(.source_dir // "")"' 2>/dev/null
      fi
      printf '%s\n' "$st"
    else
      echo "org-relay: not running on :$PORT"; exit 1
    fi
    ;;
  link-cli) link_cli ;;
  *) echo "usage: relay-ctl start|stop|status|run|install-daemon|rollback|send|purge|link-cli" >&2; exit 2 ;;
esac

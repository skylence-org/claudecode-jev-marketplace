#!/bin/sh
# board: filesystem board for herdr-agent-org (todos, comments, pads, blockers).
# Root resolution (first hit):
#   1. $HERDR_ORG_ROOT
#   2. $PWD/.herdr-org  if it exists
#   3. $HOME/.herdr-org/default
#
# Usage:
#   board init [org-name]
#   board path
#   board list [--status STATUS] [--tags a,b] [--json]
#   board ready [--json]
#   board get <slug> [--json]
#   board create <slug> [--title TEXT] [--status STATUS] [--owner NAME] [--body-file PATH] [--tags a,b]
#   board set-status <slug> <status>
#   board set-owner <slug> <agent-name|"">
#   board set-blockers <slug> <slug,slug,...|"">
#   board comment <slug> <text...>
#   board comment <slug> --stdin   # body from stdin (like pad write)
#   board query <text>
#   board pad list
#   board pad get <name>
#   board pad append <name> <text...>
#   board pad write <name>   # body from stdin
#   board pad archive <name>
#
# Status values: pending | in_progress | blocked | verified | complete
set -eu

board_root() {
  if [ -n "${HERDR_ORG_ROOT:-}" ]; then
    printf '%s\n' "$HERDR_ORG_ROOT"
    return
  fi
  if [ -d "$PWD/.herdr-org" ]; then
    printf '%s\n' "$PWD/.herdr-org"
    return
  fi
  echo "board: HERDR_ORG_ROOT unset; using ${HOME}/.herdr-org/default (wrong org? export it in the pane shell before your agent starts)" >&2
  printf '%s\n' "${HOME}/.herdr-org/default"
}

ROOT=$(board_root)
TODOS="$ROOT/todos"
PADS="$ROOT/pads"
META="$ROOT/meta"

need_root() {
  if [ ! -d "$TODOS" ]; then
    if [ -z "${HERDR_ORG_ROOT:-}" ] && [ "$ROOT" = "${HOME}/.herdr-org/default" ]; then
      echo "board: HERDR_ORG_ROOT is UNSET and the fallback $ROOT does not exist." >&2
      echo "board: almost always a missing env in THIS pane, not an uninitialized org (marketplace#125)." >&2
      echo "board: find your org:  ls ~/.herdr-org/   or   grep -rl '<todo-slug>' ~/.herdr-org/*/todos/" >&2
      echo "board: then export HERDR_ORG_ROOT=~/.herdr-org/<org> (pane shell, before the agent starts) or pass it per call." >&2
    else
      echo "board: no board at $ROOT (run: board init)" >&2
    fi
    exit 1
  fi
}

now_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

slug_ok() {
  case "$1" in
    ''|*[!a-z0-9_-]*|-*|_*|[0-9]*) return 1 ;;
  esac
  return 0
}

todo_path() {
  printf '%s/%s.md\n' "$TODOS" "$1"
}

front_get() {
  # front_get FILE KEY
  awk -v k="$2" '
    BEGIN { in_fm=0 }
    NR==1 && $0=="---" { in_fm=1; next }
    in_fm && $0=="---" { exit }
    in_fm {
      if (index($0, k ":") == 1) {
        v = substr($0, length(k)+2)
        sub(/^[ \t]+/, "", v)
        gsub(/^["'"'"']|["'"'"']$/, "", v)
        print v
        exit
      }
    }
  ' "$1"
}

# Rewrites one frontmatter key in place. Kept separate from set_field so the
# updated: stamp can reuse it without recursing.
front_set_simple() {
  f=$1; k=$2; v=$3
  tmp=$(mktemp "${TMPDIR:-/tmp}/herdr-board.XXXXXX")
  awk -v k="$k" -v v="$v" '
    BEGIN { in_fm=0; done=0 }
    NR==1 && $0=="---" { in_fm=1; print; next }
    in_fm && $0=="---" {
      if (!done) print k ": " v
      in_fm=0; print; next
    }
    in_fm {
      if (index($0, k ":") == 1) {
        print k ": " v
        done=1
        next
      }
      print
      next
    }
    { print }
  ' "$f" > "$tmp" && mv "$tmp" "$f"
}

set_field() {
  f=$1; k=$2; v=$3
  front_set_simple "$f" "$k" "$v"
  front_set_simple "$f" "updated" "$(now_utc)"
}

parse_list() {
  # parse_list RAW -> one item per line, brackets/quotes stripped, trimmed, blanks dropped
  raw=$1
  printf '%s' "$raw" | tr -d '[]"' | tr ',' '\n' | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//' | awk 'NF>0'
}

list_literal() {
  # list_literal RAW -> bracketed quoted literal in the same style cmd_set_blockers writes
  raw=$1
  if [ -z "$raw" ]; then
    printf '[]'
  else
    printf '[%s ]' "$(printf '%s' "$raw" | sed 's/,/", "/g; s/^/"/; s/$/"/')"
  fi
}

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk -v RS="$(printf '\1')" '
    BEGIN {
      for (k = 0; k < 32; k++) ctrl[sprintf("%c", k)] = sprintf("\\u%04x", k)
      ctrl["\t"] = "\\t"
      ctrl["\r"] = "\\r"
      ctrl["\n"] = "\\n"
    }
    {
      out = ""
      n = length($0)
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        if (c in ctrl) { out = out ctrl[c] } else { out = out c }
      }
      printf "%s", out
    }'
}

json_array() {
  # json_array RAW -> JSON array literal built from a blockers/tags style field
  raw=$1
  out="["
  first=1
  for item in $(parse_list "$raw"); do
    esc=$(json_escape "$item")
    if [ "$first" -eq 1 ]; then out="$out\"$esc\""; first=0
    else out="$out,\"$esc\""; fi
  done
  printf '%s]' "$out"
}

git_snapshot() {
  # git_snapshot CMD SLUG -> best-effort commit; fully silent, never fails the caller
  cmd=$1; slug=$2
  command -v git >/dev/null 2>&1 || return 0
  root_real=$(cd "$ROOT" 2>/dev/null && pwd -P) || return 0
  [ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$root_real" ] || return 0
  ( git -C "$ROOT" add -A && git -C "$ROOT" -c user.name=board -c user.email=board@local commit -q -m "$cmd $slug" ) >/dev/null 2>&1 || true
  return 0
}

cmd_init() {
  name=${1:-default}
  case "$name" in
    /*|./*|../*) target=$name ;;
    *) target="${HOME}/.herdr-org/${name}" ;;
  esac
  mkdir -p "$target/todos" "$target/pads" "$target/meta"
  if [ ! -f "$target/meta/org.json" ]; then
    cat > "$target/meta/org.json" <<EOF
{
  "name": "$(basename "$target")",
  "created": "$(now_utc)",
  "substrate": "herdr",
  "runtime": "claude",
  "version": 1
}
EOF
  fi
  if [ ! -f "$target/pads/inbox.md" ]; then
    printf '# Inbox\n\nOperator questions and escalations land here.\n' > "$target/pads/inbox.md"
  fi
  if command -v git >/dev/null 2>&1; then
    ( git -C "$target" init -q && git -C "$target" add -A && git -C "$target" -c user.name=board -c user.email=board@local commit -q -m "init $(basename "$target")" ) >/dev/null 2>&1 || true
  fi

  printf 'board root: %s\n' "$target"
  printf 'export HERDR_ORG_ROOT=%s\n' "$target"
}

cmd_list() {
  need_root
  filter=""
  tags_filter=""
  json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --status) filter=$2; shift 2 ;;
      --tags) tags_filter=$2; shift 2 ;;
      --json) json=1; shift ;;
      *) shift ;;
    esac
  done
  first=1
  if [ "$json" -eq 1 ]; then
    printf '['
  else
    printf '%-20s %-12s %-16s %s\n' "SLUG" "STATUS" "OWNER" "TITLE"
    printf '%-20s %-12s %-16s %s\n' "----" "------" "-----" "-----"
  fi
  for f in "$TODOS"/*.md; do
    [ -f "$f" ] || continue
    slug=$(basename "$f" .md)
    st=$(front_get "$f" status)
    ow=$(front_get "$f" owner)
    ti=$(front_get "$f" title)
    tags_raw=$(front_get "$f" tags)
    blockers_raw=$(front_get "$f" blockers)
    if [ -n "$filter" ] && [ "$st" != "$filter" ]; then
      continue
    fi
    if [ -n "$tags_filter" ]; then
      match=0
      have=$(parse_list "$tags_raw")
      if [ -n "$have" ]; then
        for w in $(parse_list "$tags_filter"); do
          for h in $have; do
            if [ "$w" = "$h" ]; then
              match=1
            fi
          done
        done
      fi
      [ "$match" -eq 1 ] || continue
    fi
    if [ "$json" -eq 1 ]; then
      [ "$first" -eq 1 ] || printf ','
      first=0
      printf '{"slug":"%s","title":"%s","status":"%s","owner":"%s","tags":%s,"blockers":%s}' \
        "$(json_escape "$slug")" "$(json_escape "$ti")" "$(json_escape "$st")" "$(json_escape "$ow")" \
        "$(json_array "$tags_raw")" "$(json_array "$blockers_raw")"
    else
      printf '%-20s %-12s %-16s %s\n' "$slug" "$st" "${ow:--}" "${ti:--}"
    fi
  done
  if [ "$json" -eq 1 ]; then
    printf ']\n'
  fi
}

cmd_ready() {
  need_root
  json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) shift ;;
    esac
  done
  first=1
  if [ "$json" -eq 1 ]; then
    printf '['
  else
    printf '%-20s %-12s %-16s %s\n' "SLUG" "STATUS" "OWNER" "TITLE"
    printf '%-20s %-12s %-16s %s\n' "----" "------" "-----" "-----"
  fi
  for f in "$TODOS"/*.md; do
    [ -f "$f" ] || continue
    slug=$(basename "$f" .md)
    st=$(front_get "$f" status)
    [ "$st" = "pending" ] || continue
    blockers_raw=$(front_get "$f" blockers)
    ready=1
    for b in $(parse_list "$blockers_raw"); do
      bp=$(todo_path "$b")
      if [ ! -f "$bp" ]; then
        ready=0
        break
      fi
      bst=$(front_get "$bp" status)
      if [ "$bst" != "complete" ]; then
        ready=0
        break
      fi
    done
    [ "$ready" -eq 1 ] || continue
    ow=$(front_get "$f" owner)
    ti=$(front_get "$f" title)
    tags_raw=$(front_get "$f" tags)
    if [ "$json" -eq 1 ]; then
      [ "$first" -eq 1 ] || printf ','
      first=0
      printf '{"slug":"%s","title":"%s","status":"%s","owner":"%s","tags":%s,"blockers":%s}' \
        "$(json_escape "$slug")" "$(json_escape "$ti")" "$(json_escape "$st")" "$(json_escape "$ow")" \
        "$(json_array "$tags_raw")" "$(json_array "$blockers_raw")"
    else
      printf '%-20s %-12s %-16s %s\n' "$slug" "$st" "${ow:--}" "${ti:--}"
    fi
  done
  if [ "$json" -eq 1 ]; then
    printf ']\n'
  fi
}

cmd_get() {
  need_root
  slug=$1; shift || true
  json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) shift ;;
    esac
  done
  p=$(todo_path "$slug")
  [ -f "$p" ] || { echo "board: no todo $slug" >&2; exit 1; }

  if [ "$json" -eq 1 ]; then
    st=$(front_get "$p" status)
    ti=$(front_get "$p" title)
    ow=$(front_get "$p" owner)
    tags_raw=$(front_get "$p" tags)
    blockers_raw=$(front_get "$p" blockers)

    body=$(awk '
      BEGIN { fm_count=0; in_body=0; first=1 }
      /^---$/ && fm_count < 2 {
        fm_count++
        if (fm_count == 2) { in_body=1 }
        next
      }
      /^## Comments$/ { exit }
      in_body == 1 {
        if (!first) printf "\n"
        printf "%s", $0
        first=0
      }
    ' "$p")

    comment_count=$(sed -n '/^## Comments$/,$p' "$p" | awk '/^### / { count++ } END { print count+0 }')

    printf '{\"slug\":\"%s\",\"title\":\"%s\",\"status\":\"%s\",\"owner\":\"%s\",\"tags\":%s,\"blockers\":%s,\"comment_count\":%d,\"body\":\"%s\"}\n' \
      "$(json_escape "$slug")" "$(json_escape "$ti")" "$(json_escape "$st")" "$(json_escape "$ow")" \
      "$(json_array "$tags_raw")" "$(json_array "$blockers_raw")" "$comment_count" "$(json_escape "$body")"
  else
    cat "$p"
  fi
}

cmd_create() {
  need_root
  slug=$1; shift
  slug_ok "$slug" || { echo "board: bad slug (use [a-z][a-z0-9_-]*)" >&2; exit 2; }
  p=$(todo_path "$slug")
  [ ! -f "$p" ] || { echo "board: todo $slug exists" >&2; exit 1; }
  title=$slug
  status=pending
  owner=""
  body_file=""
  tags=""
  tags_set=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --title) title=$2; shift 2 ;;
      --status) status=$2; shift 2 ;;
      --owner) owner=$2; shift 2 ;;
      --body-file) body_file=$2; shift 2 ;;
      --tags) tags=$2; tags_set=1; shift 2 ;;
      *) shift ;;
    esac
  done
  ts=$(now_utc)
  {
    printf '%s\n' "---"
    printf 'id: %s\n' "$slug"
    printf 'title: %s\n' "$title"
    printf 'status: %s\n' "$status"
    printf 'owner: %s\n' "$owner"
    printf 'blockers: []\n'
    if [ "$tags_set" -eq 1 ]; then
      printf 'tags: %s\n' "$(list_literal "$tags")"
    fi
    printf 'created: %s\n' "$ts"
    printf 'updated: %s\n' "$ts"
    printf '%s\n\n' "---"
    if [ -n "$body_file" ]; then
      cat "$body_file"
    else
      printf '# %s\n\n(brief body)\n' "$title"
    fi
    printf '\n## Comments\n'
  } > "$p"
  printf 'created %s\n' "$p"
  git_snapshot create "$slug"
}

publish_sidebar_status() {
  # publish_sidebar_status SLUG STATUS
  # Best-effort: silent on any failure so the board never depends on herdr.
  slug=$1; st=$2
  herdr_bin="${HERDR_BIN_PATH:-herdr}"
  command -v "$herdr_bin" >/dev/null 2>&1 || return 0
  waker_cfg="${HERDR_ORG_WAKER_CFG:-$(herdr plugin config-dir skylence.org-waker 2>/dev/null || true)}"
  [ -n "$waker_cfg" ] || return 0
  row="$waker_cfg/registry/$(printf '%s' "$slug" | tr ':/' '--').row"
  [ -f "$row" ] || return 0
  pane=$(awk -F'\t' '{print $1; exit}' "$row" 2>/dev/null || true)
  [ -n "$pane" ] || return 0
  if [ "$st" = "complete" ]; then
    "$herdr_bin" pane report-metadata "$pane" --source herdr-org-board --clear-token task --clear-token status >/dev/null 2>&1 || true
  else
    "$herdr_bin" pane report-metadata "$pane" --source herdr-org-board --token "task=$slug" --token "status=$st" >/dev/null 2>&1 || true
  fi
  return 0
}

cmd_set_status() {
  need_root
  slug=$1; st=$2
  p=$(todo_path "$slug")
  [ -f "$p" ] || { echo "board: no todo $slug" >&2; exit 1; }
  case "$st" in
    pending|in_progress|blocked|verified|complete) ;;
    *) echo "board: bad status" >&2; exit 2 ;;
  esac
  set_field "$p" status "$st"
  publish_sidebar_status "$slug" "$st"
  git_snapshot set-status "$slug"
  printf 'status %s -> %s\n' "$slug" "$st"
}

cmd_set_owner() {
  need_root
  slug=$1; ow=${2:-}
  p=$(todo_path "$slug")
  [ -f "$p" ] || { echo "board: no todo $slug" >&2; exit 1; }
  set_field "$p" owner "$ow"
  git_snapshot set-owner "$slug"
  printf 'owner %s -> %s\n' "$slug" "${ow:-(cleared)}"
}

cmd_set_blockers() {
  need_root
  slug=$1; raw=${2:-}
  p=$(todo_path "$slug")
  [ -f "$p" ] || { echo "board: no todo $slug" >&2; exit 1; }
  if [ -z "$raw" ]; then
    val="[]"
  else
    val="[$(printf '%s' "$raw" | sed 's/,/", "/g; s/^/"/; s/$/"/') ]"
  fi
  set_field "$p" blockers "$val"
  git_snapshot set-blockers "$slug"
  printf 'blockers %s -> %s\n' "$slug" "$val"
}

cmd_comment() {
  need_root
  slug=$1; shift
  p=$(todo_path "$slug")
  [ -f "$p" ] || { echo "board: no todo $slug" >&2; exit 1; }
  case "${1:-}" in
    --stdin|-)
      shift
      [ "$#" -eq 0 ] || { echo "board: --stdin takes no further arguments" >&2; exit 2; }
      text=$(cat)
      ;;
    -*)
      # A swallowed flag once posted the literal string "--stdin" as a
      # comment and silently dropped the piped body (skylore mark 305).
      echo "board: unknown flag $1 for comment; text is positional, use --stdin to pipe a body" >&2
      exit 2
      ;;
    *)
      text=$*
      ;;
  esac
  [ -n "$text" ] || { echo "board: empty comment" >&2; exit 2; }
  ts=$(now_utc)
  printf '\n### %s\n\n%s\n' "$ts" "$text" >> "$p"
  front_set_simple "$p" "updated" "$ts"
  git_snapshot comment "$slug"
  printf 'commented %s\n' "$slug"
}

cmd_query() {
  need_root
  text=$*
  [ -n "$text" ] || return 0
  for f in "$TODOS"/*.md; do
    [ -f "$f" ] || continue
    if grep -qiF -- "$text" "$f"; then
      slug=$(basename "$f" .md)
      ti=$(front_get "$f" title)
      printf '%s\t%s\n' "$slug" "$ti"
    fi
  done
}

cmd_pad_list() {
  need_root
  for f in "$PADS"/*; do
    [ -f "$f" ] || continue
    basename "$f"
  done
}

cmd_pad_get() {
  need_root
  name=$1
  p="$PADS/$name"
  [ -f "$p" ] || p="$PADS/${name}.md"
  [ -f "$p" ] || { echo "board: no pad $name" >&2; exit 1; }
  cat "$p"
}

cmd_pad_append() {
  need_root
  name=$1; shift
  p="$PADS/$name"
  case "$name" in
    *.md) ;;
    *) p="$PADS/${name}.md" ;;
  esac
  [ -f "$p" ] || printf '# %s\n\n' "$(basename "$p" .md)" > "$p"
  printf '\n### %s\n\n%s\n' "$(now_utc)" "$*" >> "$p"
  git_snapshot "pad append" "$name"
  printf 'appended %s\n' "$p"
}

cmd_pad_write() {
  need_root
  name=$1
  p="$PADS/$name"
  case "$name" in
    *.md) ;;
    *) p="$PADS/${name}.md" ;;
  esac
  cat > "$p"
  git_snapshot "pad write" "$name"
  printf 'wrote %s\n' "$p"
}

cmd_pad_archive() {
  need_root
  name=$1
  p="$PADS/$name"
  case "$name" in
    *.md) ;;
    *) p="$PADS/${name}.md" ;;
  esac
  [ -f "$p" ] || { echo "board: no pad $name" >&2; exit 1; }
  mkdir -p "$PADS/archive"
  mv "$p" "$PADS/archive/$(basename "$p")"
  git_snapshot "pad archive" "$name"
  printf 'archived pads/archive/%s\n' "$(basename "$p")"
}

usage() {
  awk 'NR > 1 { if (!/^#/) exit; s = $0; sub(/^# ?/, "", s); print s }' "$0"
  exit 2
}

[ "$#" -ge 1 ] || usage
cmd=$1; shift
case "$cmd" in
  init) cmd_init "${1:-default}" ;;
  path) printf '%s\n' "$ROOT" ;;
  list) cmd_list "$@" ;;
  ready) cmd_ready "$@" ;;
  get) [ "$#" -ge 1 ] || usage; cmd_get "$@" ;;
  create) [ "$#" -ge 1 ] || usage; cmd_create "$@" ;;
  set-status) [ "$#" -ge 2 ] || usage; cmd_set_status "$1" "$2" ;;
  set-owner) [ "$#" -ge 1 ] || usage; cmd_set_owner "$1" "${2:-}" ;;
  set-blockers) [ "$#" -ge 1 ] || usage; cmd_set_blockers "$1" "${2:-}" ;;
  comment) [ "$#" -ge 2 ] || usage; cmd_comment "$@" ;;
  query) [ "$#" -ge 1 ] || usage; cmd_query "$@" ;;
  pad)
    sub=${1:-}; shift || true
    case "$sub" in
      list) cmd_pad_list ;;
      get) [ "$#" -ge 1 ] || usage; cmd_pad_get "$1" ;;
      append) [ "$#" -ge 2 ] || usage; cmd_pad_append "$@" ;;
      write) [ "$#" -ge 1 ] || usage; cmd_pad_write "$1" ;;
      archive) [ "$#" -ge 1 ] || usage; cmd_pad_archive "$1" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac

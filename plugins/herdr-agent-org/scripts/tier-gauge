#!/bin/sh
# tier-gauge: L17 TIER BY BRIEF, measured instead of remembered.
#
# One Jev request over a lane brief answers: which tier of worker the brief
# needs (a Choice over descriptions of the WORK, never model names), whether
# the lane is risky (L10 surfaces), and whether the brief carries three
# template items a worker cannot do without (lane tree path, milestone
# comments, inlined board calls). dispatch-worker calls this once per dispatch;
# the one-line verdict it prints is filed on the lane todo as [TIER-GAUGE: ...].
#
#   tier-gauge (--todo SLUG | --brief-file PATH) [--model M] [--effort E] [--json] [--show-brief]
#   tier-gauge --todo SLUG --round-only
#
# WHAT IS GAUGED (0.1.7): what the next worker actually receives. A todo that
# carries a bounce comment (the 0.1.6 bounce doctrine: it opens with the
# DIGEST and carries that round's ruling) is gauged on its LATEST such comment,
# not the original body plus the trail: 6 of 6 replacer dispatches in one
# session got the original brief's verdict, and body plus trail reads as hard
# even for a precise fix list. A comment counts as a bounce only in the
# orchestrator's format: its first non-blank line starts with `**[BOUNCE r/n]`
# or `**[BOUNCE 4 / ESCALATION]` (bold optional), so a worker's
# `[BOUNCE 2/3 FIXES]` milestone or a note naming the round never replaces the
# ruling. Comments are the `### <YYYY-MM-DDTHH:MM:SSZ>` sections after the
# board's own (last) `## Comments` heading. A bounce with no DIGEST falls back
# to the body and says `bounce-without-digest`. No bounce: the body. A review
# lane always gauges its body, the review brief, never an inherited trail. The
# template lint is skipped on a bounce (a DIGEST is not a brief; the brief was
# linted at first dispatch). The verdict line names it: source=body|bounce.
# --show-brief prints the text that would be gauged and exits 0, no Jev call.
# --round-only prints the round of that same latest bounce comment (r of
# `[BOUNCE r/n]`, 4 for `[BOUNCE 4 / ESCALATION]`, nothing when there is none
# or the lane is a review lane) and exits 0, no Jev call. dispatch-worker
# --replacer names its round from this, so the pointer and the gauge read one
# parser.
#
# Exit 0: ok or warn (warnings on stderr, verdict line on stdout).
# Exit 3: REFUSE — a cheap tier (--model haiku, --effort low) was requested
#         for a brief the gauge reads as not mechanical, at or above
#         thresholds.downgrade_bar. The doctrine measured this shape (a
#         prose-spec brief on a cheap tier) at 2-3x the turns; dispatch-worker
#         turns the refusal into a hard stop, the same way it refuses a missing
#         --upgrade-reason.
# Exit 0 with verdict=ungauged: Jev unavailable (no key, timeout, disabled).
#         The org proceeds exactly as it did before this script existed.
# Exit 2: usage error.
#
# Policy lives HERE, in code, so a threshold change is a one-line diff:
#   requested cheap  AND tier != mechanical AND conf >= downgrade_bar  -> refuse
#   tier == hard AND conf >= upgrade_bar AND requested != top          -> warn, upgrade=advised
#   risky >= thresholds.risky                                          -> warn (L10 review gate likely mandatory)
#   any lint noul < thresholds.lint                                    -> warn (brief template item missing)
# Never auto-upgrades: an upgrade is an explicit, filed act (L17). The verdict
# line carries `upgrade=advised` on the hard-brief warning, and dispatch-worker
# stops there until the orchestrator chooses --upgrade-reason or --keep-tier.
# A review lane (the reviewer-brief header, or a rev-/rev2- todo) posts ONE
# report by design, so the milestone-comments lint item is skipped for it.
set -u

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
JEV="$HERE/jev"
[ -x "$JEV" ] || JEV="sh $HERE/jev"
export JEV_QUESTIONS="${JEV_QUESTIONS:-$HERE/jev-questions.json}"

TODO=""; FILE=""; MODEL=""; EFFORT=""; JSON=0; SHOW=0; ROUND_ONLY=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --todo) TODO=$2; shift 2 ;;
    --brief-file) FILE=$2; shift 2 ;;
    --model) MODEL=$2; shift 2 ;;
    --effort) EFFORT=$2; shift 2 ;;
    --json) JSON=1; shift ;;
    --show-brief) SHOW=1; shift ;;
    --round-only) ROUND_ONLY=1; shift ;;
    -h|--help) awk 'NR > 1 { if (!/^#/) exit; s = $0; sub(/^# ?/, "", s); print s }' "$0"; exit 0 ;;
    *) echo "tier-gauge: unknown argument $1" >&2; exit 2 ;;
  esac
done
{ [ -n "$TODO" ] || [ -n "$FILE" ]; } || { echo "tier-gauge: --todo SLUG or --brief-file PATH required" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "tier-gauge: jq required" >&2; exit 2; }

if [ -n "$FILE" ]; then
  [ -f "$FILE" ] || { echo "tier-gauge: no such file $FILE" >&2; exit 2; }
  BRIEF=$(cat "$FILE")
else
  BOARD=""
  if command -v board >/dev/null 2>&1; then BOARD=board
  elif [ -x "$HERE/board" ]; then BOARD="$HERE/board"
  fi
  [ -n "$BOARD" ] || { echo "tier-gauge: board CLI not found (PATH or $HERE/board)" >&2; exit 2; }
  BRIEF=$("$BOARD" get "$TODO" --json 2>/dev/null | jq -r '.body // empty') || BRIEF=""
  [ -n "$BRIEF" ] || { echo "tier-gauge: todo '$TODO' has no body (board get $TODO --json)" >&2; exit 2; }
fi

REVIEW_LANE=0
case "$TODO" in rev-*|rev2-*) REVIEW_LANE=1 ;; esac
case "$BRIEF" in *"You are the review lane for todo"*) REVIEW_LANE=1 ;; esac
SOURCE=body; SOURCE_NOTE=""
if [ -n "$TODO" ] && [ "$REVIEW_LANE" -eq 0 ]; then
  BOUNCE=$("$BOARD" get "$TODO" 2>/dev/null | awk '
    { line[NR] = $0; if ($0 == "## Comments") start = NR }
    END {
      if (!start) exit
      hdr = "^### [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$"
      mark = "^(\\*\\*)?\\[BOUNCE ([0-9]+/[0-9]+|4 / ESCALATION)\\]"
      cur = ""; first = ""; last = ""
      for (i = start + 1; i <= NR; i++) {
        if (line[i] ~ hdr) { if (first ~ mark) last = cur; cur = ""; first = ""; continue }
        cur = cur line[i] "\n"
        if (first == "" && line[i] ~ /[^ \t]/) { first = line[i]; sub(/^[ \t]+/, "", first) }
      }
      if (first ~ mark) last = cur
      printf "%s", last
    }') || BOUNCE=""
  if [ -n "$(printf '%s' "$BOUNCE" | tr -d '[:space:]')" ]; then
    case "$BOUNCE" in
      *DIGEST*) BRIEF=$BOUNCE; SOURCE=bounce ;;
      *) SOURCE_NOTE=" bounce-without-digest" ;;
    esac
  fi
fi
if [ "$ROUND_ONLY" -eq 1 ]; then
  [ -n "$TODO" ] || { echo "tier-gauge: --round-only needs --todo SLUG" >&2; exit 2; }
  printf '%s\n' "${BOUNCE:-}" | awk 'NF { sub(/^[ \t]+/, ""); print; exit }' \
    | sed -n -E -e 's/^(\*\*)?\[BOUNCE 0*([0-9]+)\/[0-9]+\].*/\2/p' -e 's/^(\*\*)?\[BOUNCE 4 \/ ESCALATION\].*/4/p'
  exit 0
fi
if [ "$SHOW" -eq 1 ]; then
  printf '%s\n' "$BRIEF"
  exit 0
fi

# Requested tier from the dispatch args: cheap / default / top.
REQ=default
case "$MODEL" in *haiku*) REQ=cheap ;; *opus*) REQ=top ;; esac
case "$EFFORT" in low) REQ=cheap ;; high|max|xhigh) REQ=top ;; esac

MODEL_ID="${JEV_MODEL:-jev-1.13.0}"
# 80k chars keeps a code-heavy brief inside the 32k-token state budget
# (code tokenizes at roughly 3 chars per token); anything longer is truncated
# rather than turned into a 422 that would read as "ungauged".
ANSWERS=$(jq -nc --arg b "$(printf '%s' "$BRIEF" | head -c 80000)" '{brief: $b}' | $JEV ask tier-gauge 2>/dev/null) || ANSWERS=""
if [ -z "$ANSWERS" ]; then
  echo "tier-gauge: Jev gave no answer (no key, timeout, or disabled); lane dispatches ungauged" >&2
  [ "$JSON" -eq 1 ] && { jq -nc --arg r "$REQ" --arg s "$SOURCE" '{verdict:"ungauged", requested:$r, source:$s}'; exit 0; }
  echo "TIER-GAUGE: $MODEL_ID verdict=ungauged requested=$REQ source=$SOURCE$SOURCE_NOTE"
  exit 0
fi

TIER=$(printf '%s' "$ANSWERS" | jq -r '.tier.choice // empty')
CONF=$(printf '%s' "$ANSWERS" | jq -r '.tier.confidence // 0')
RISKY=$(printf '%s' "$ANSWERS" | jq -r '.risky.noul // 0')
L_TREE=$(printf '%s' "$ANSWERS" | jq -r '.names_lane_tree.noul // 1')
L_MILE=$(printf '%s' "$ANSWERS" | jq -r '.orders_milestones.noul // 1')
L_SNIP=$(printf '%s' "$ANSWERS" | jq -r '.inlines_board_snippets.noul // 1')
[ -n "$TIER" ] || { echo "tier-gauge: reply lacked a tier; ungauged" >&2; echo "TIER-GAUGE: $MODEL_ID verdict=ungauged requested=$REQ source=$SOURCE$SOURCE_NOTE"; exit 0; }

T_DOWN=$($JEV threshold tier-gauge downgrade_bar); T_UP=$($JEV threshold tier-gauge upgrade_bar)
T_RISK=$($JEV threshold tier-gauge risky); T_LINT=$($JEV threshold tier-gauge lint)
ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }
lt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }'; }

VERDICT=ok; WARN=""; ADVISED=""
if [ "$REQ" = cheap ] && [ "$TIER" != mechanical ] && ge "$CONF" "$T_DOWN"; then
  VERDICT=refuse
elif [ "$TIER" = hard ] && ge "$CONF" "$T_UP" && [ "$REQ" != top ]; then
  VERDICT=warn; ADVISED=1; WARN="brief reads as HARD (conf $CONF >= $T_UP) and the lane is not on the top tier; dispatch-worker stops here: pass --model opus --upgrade-reason \"...\" or --keep-tier \"<why>\" (L17)"
fi
if ge "$RISKY" "$T_RISK"; then
  [ "$VERDICT" = ok ] && VERDICT=warn
  WARN="${WARN:+$WARN; }risky=$RISKY >= $T_RISK: expect L10 MANDATORY-REVIEW at accept"
fi
LINT=""
if [ "$SOURCE" = body ]; then
  lt "$L_TREE" "$T_LINT" && LINT="${LINT:+$LINT,}lane-tree-path"
  [ "$REVIEW_LANE" -eq 0 ] && lt "$L_MILE" "$T_LINT" && LINT="${LINT:+$LINT,}milestone-comments"
  lt "$L_SNIP" "$T_LINT" && LINT="${LINT:+$LINT,}board-snippets"
fi
if [ -n "$LINT" ]; then
  [ "$VERDICT" = ok ] && VERDICT=warn
  WARN="${WARN:+$WARN; }brief template items look missing: $LINT (brief template 2/4/7)"
fi

[ -n "$WARN" ] && echo "tier-gauge: $WARN" >&2

if [ "$JSON" -eq 1 ]; then
  jq -nc --arg v "$VERDICT" --arg r "$REQ" --arg t "$TIER" --argjson c "$CONF" --argjson k "$RISKY" --arg l "$LINT" --arg m "$MODEL_ID" --arg a "$ADVISED" --arg s "$SOURCE" \
    '{verdict:$v, requested:$r, tier:$t, confidence:$c, risky:$k, lint_missing:($l|split(",")|map(select(length>0))), upgrade_advised:($a == "1"), source:$s, model:$m}'
else
  echo "TIER-GAUGE: $MODEL_ID tier=$TIER conf=$CONF risky=$RISKY requested=$REQ verdict=$VERDICT source=$SOURCE$SOURCE_NOTE${ADVISED:+ upgrade=advised}${LINT:+ lint=$LINT}"
fi

if [ "$VERDICT" = refuse ]; then
  echo "tier-gauge: REFUSED — requested a cheap tier (${MODEL:-$EFFORT}) for a brief the gauge reads as '$TIER' at confidence $CONF (>= $T_DOWN). A prose-spec brief on a cheap tier costs 2-3x the turns (L17 TIER BY BRIEF). Rewrite the brief to transcription grade, dispatch at the default tier, or pass --no-gauge WITH an [L13 LAW-FRICTION] filing on the todo." >&2
  exit 3
fi
exit 0
